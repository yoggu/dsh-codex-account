# Die Entwicklungssymlinks auf den Harness-Baum. Sie sind maschinenspezifisch
# und werden von `pnpm add` im Profil ersetzt — nie committen.
node_modules/

# Laufzeit- und Debug-Artefakte
*.log
*.tmp
.cache/

# Editor
.vscode/
.idea/
*.swp

# Legacy 0.1.x account stores and credential files must never enter this repo.
# The current plugin delegates credential ownership to the shipped llm-pi-ai
# adapter and does not keep its own store. Retain this migration safety net.
codex-accounts.json
*.credentials.yaml
